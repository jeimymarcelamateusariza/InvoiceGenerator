# Backend API (requerido — build + runtime en Coolify)
NEXT_PUBLIC_API_URL=https://back.ispstart.com/

# Dominio base para multi-tenant (sin https://)
APP_BASE_DOMAIN=ispstart.com

# Coolify: NO uses SERVICE_URL_WEB_3000 — Coolify la genera sola con :3000 y no se puede editar.
# En su lugar, agrega tus dominios en Coolify → servicio web → Domains:
#   - ispstart.com          (dominio principal)
#   - *.ispstart.com        (subdominios de tenants, si aplica)
# Coolify inyecta SERVICE_URL_WEB y SERVICE_FQDN_WEB automáticamente al agregar dominios.

# Solo para desarrollo local (npm run dev). No definir en el build de Docker:
# fuerza un tenant fijo en lugar de usar el host del navegador.
# NEXT_PUBLIC_TENANT_DOMAIN=demo.ispstart.com

# Ruta a la base de datos SQLite para gestión de rutas
DB_PATH=./data/rutas.db

